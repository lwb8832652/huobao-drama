# Docker 部署环境变量（复制为 .env 后修改）
# Watchtower HTTP API 令牌，app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# 应用镜像地址（CI 推送 dev 分支到阿里云 ACR 后，Watchtower/手动 pull 拉的就是它）
# 日常跟随 dev 漂动标签；生产建议固定不可变标签以便回滚，如 :dev-<完整提交SHA>
HUOBAO_IMAGE=registry.cn-hangzhou.aliyuncs.com/wenbo_pub/huobao-drama:dev
